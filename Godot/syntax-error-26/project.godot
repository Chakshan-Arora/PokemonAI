; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PokémonAI"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoloads/EventBus.gd"
GameData="*res://scripts/autoloads/GameData.gd"
GameState="*res://scripts/autoloads/GameState.gd"
QuestSystem="*res://scripts/systems/QuestSystem.gd"
SaveLoad="*res://scripts/autoloads/SaveLoad.gd"
LLMClient="*res://scripts/autoloads/LLMClient.gd"
BattleTransition="*res://scripts/autoloads/BattleTransition.gd"
SoundManager="*res://scripts/autoloads/SoundManager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/pokemon_theme.tres"

