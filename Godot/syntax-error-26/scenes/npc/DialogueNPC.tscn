[sub_resource type="GDScript" id="GDScript_dialogue_npc"]
script/source = "extends StaticBody3D

@export var npc_id: String = \"guide\"
@export var npc_name: String = \"Guide\"
@export_enum(\"red\", \"calem\", \"serena\", \"koji\") var sprite_variant: String = \"red\"
@export_multiline var dialogue_text: String = \"Welcome to the Pokémon world! Talk with your Pokémon often to deepen your bond.\"

@onready var label_3d: Label3D = $Label3D
@onready var sprite_3d: Sprite3D = $Sprite3D

func _ready() -> void:
	add_to_group(\"interactable\")
	if is_instance_valid(label_3d):
		label_3d.text = npc_name
	
	if is_instance_valid(sprite_3d):
		var path = \"res://assets/sprites/trainers/%s.png\" % sprite_variant.to_lower()
		if ResourceLoader.exists(path):
			sprite_3d.texture = load(path)

func get_interaction_text() -> String:
	return \"Talk to \" + npc_name

func on_interact(_player_node: Node3D) -> void:
	EventBus.show_message.emit(dialogue_text)
"

