[sub_resource type="GDScript" id="GDScript_trainernpc"]
script/source = "extends \"res://scripts/npc/TrainerNPC.gd\"

func _ready() -> void:
	add_to_group(\"interactable\")
	if is_instance_valid(label_3d):
		label_3d.text = trainer_name
	
	if is_instance_valid(sprite_3d):
		var path = \"res://assets/sprites/trainers/%s.png\" % trainer_id.to_lower()
		if ResourceLoader.exists(path):
			sprite_3d.texture = load(path)
		else:
			var fb = \"res://assets/sprites/trainers/koji.png\"
			var tid = trainer_id.to_lower()
			if \"haley\" in tid or \"kira\" in tid or \"lass\" in tid:
				fb = \"res://assets/sprites/trainers/misty.png\"
			elif \"brock\" in tid or \"david\" in tid or \"hiker\" in tid:
				fb = \"res://assets/sprites/trainers/ash.png\"
			elif \"joey\" in tid or \"edward\" in tid or \"psychic\" in tid:
				fb = \"res://assets/sprites/trainers/ash.png\"
			if ResourceLoader.exists(fb):
				sprite_3d.texture = load(fb)
"

