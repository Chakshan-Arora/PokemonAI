[ext_resource type="Texture2D" path="res://assets/sprites/world/bush.png" id="2_bush"]

[sub_resource type="GDScript" id="GDScript_bushprop"]
script/source = "extends Node3D

@export_enum(\"bush\", \"flowers\") var prop_type: String = \"bush\"
@onready var sprite: Sprite3D = $Sprite3D

func _ready() -> void:
	if is_instance_valid(sprite):
		if prop_type == \"flowers\":
			var tex = load(\"res://assets/sprites/world/flowers.png\")
			if tex:
				sprite.texture = tex
				sprite.pixel_size = 0.04
				sprite.position.y = 0.4
		else:
			var tex = load(\"res://assets/sprites/world/bush.png\")
			if tex:
				sprite.texture = tex
				sprite.pixel_size = 0.045
				sprite.position.y = 0.6
"

