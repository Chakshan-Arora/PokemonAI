[ext_resource type="Texture2D" path="res://assets/sprites/world/campfire.png" id="2_fire"]

[sub_resource type="GDScript" id="GDScript_campfire"]
script/source = "extends StaticBody3D

@export var camp_name: String = \"Campfire Rest Area\"
@onready var label_3d: Label3D = $Label3D

func _ready() -> void:
	add_to_group(\"interactable\")
	if is_instance_valid(label_3d):
		label_3d.text = camp_name

func get_interaction_text() -> String:
	return \"Rest by Campfire\"

func on_interact(_player_node: Node3D) -> void:
	if GameState.player != null:
		for p in GameState.player.team:
			p.current_hp = p.max_hp
			p.status_effects.clear()
		EventBus.hud_update_requested.emit()
		EventBus.show_message.emit(\"You rested by the campfire. All your Pokémon were fully restored!\")
		SaveLoad.save_game()
"

