[gd_scene load_steps=13 format=3 uid="uid://c8y3xqjOakHouse"]

[sub_resource type="GDScript" id="GDScript_oak_house"]
script/source = "extends StaticBody3D

@export var house_name: String = \"Oak's Residence\"
@onready var label_3d: Label3D = $Label3D

func _ready() -> void:
	add_to_group(\"interactable\")
	if is_instance_valid(label_3d):
		label_3d.text = house_name

func get_interaction_text() -> String:
	return \"Knock on Oak's Door\"

func on_interact(_player_node: Node3D) -> void:
	if GameState.player != null and not GameState.player.team.is_empty():
		for p in GameState.player.team:
			p.friendship = clampi(p.friendship + 15, 0, 255)
		EventBus.hud_update_requested.emit()
	EventBus.show_message.emit(\"Daisy Oak: Hello Ash! Grandpa is at his Research Lab just south of here. Have some warm tea! (Your Pokémon feel happier!)\")
"

