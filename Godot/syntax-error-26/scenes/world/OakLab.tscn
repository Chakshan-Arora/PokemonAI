[gd_scene load_steps=18 format=3 uid="uid://c8y3xqjOakLab"]

[sub_resource type="GDScript" id="GDScript_oak_lab"]
script/source = "extends StaticBody3D

@export var lab_name: String = \"Oak Pokémon Research Lab\"
@onready var label_3d: Label3D = $Label3D

func _ready() -> void:
	add_to_group(\"interactable\")
	if is_instance_valid(label_3d):
		label_3d.text = lab_name

func get_interaction_text() -> String:
	return \"Examine Lab Main Entrance\"

func on_interact(_player_node: Node3D) -> void:
	var team_count = 0
	if GameState.player != null:
		team_count = GameState.player.team.size()
	EventBus.show_message.emit(\"Oak Lab Terminal: [ONLINE] Welcome to Professor Oak's Pokémon Research Facility! Active companions registered: %d. Oak's advice: 'Wild Pokémon inhabit tall grass! Treat them with care.'\" % team_count)
"

