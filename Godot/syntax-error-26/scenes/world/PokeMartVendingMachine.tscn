[gd_scene load_steps=17 format=3 uid="uid://c8y3xqjPokeMartVM"]

[sub_resource type="GDScript" id="GDScript_pokemart_vm"]
script/source = "extends StaticBody3D

@export var machine_name: String = \"PokéMart Vending Machine\"

func _ready() -> void:
	add_to_group(\"interactable\")

func get_interaction_text() -> String:
	return \"Use PokéMart Vending Machine\"

func on_interact(_player_node: Node3D) -> void:
	EventBus.open_pokemart.emit()
"

