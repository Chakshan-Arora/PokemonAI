[sub_resource type="GDScript" id="GDScript_rockprop"]
script/source = "extends StaticBody3D

@export_enum(\"rock\", \"boulder\") var rock_type: String = \"rock\"
@onready var sprite: Sprite3D = $Sprite3D

func _ready() -> void:
	if is_instance_valid(sprite):
		if rock_type == \"boulder\":
			var tex = load(\"res://assets/sprites/world/boulder.png\")
			if tex:
				sprite.texture = tex
				sprite.pixel_size = 0.05
				sprite.position.y = 0.55
		else:
			var tex = load(\"res://assets/sprites/world/rock.png\")
			if tex:
				sprite.texture = tex
				sprite.pixel_size = 0.065
				sprite.position.y = 0.75
"

