[sub_resource type="GDScript" id="GDScript_pillar"]
script/source = "extends StaticBody3D

@export_enum(\"standard\", \"spectral\", \"overgrown\") var pillar_variant: String = \"standard\"
@onready var sprite: Sprite3D = $Sprite3D

func _ready() -> void:
	if is_instance_valid(sprite):
		match pillar_variant:
			\"spectral\":
				sprite.modulate = Color(0.72, 0.65, 0.98, 0.92)
			\"overgrown\":
				sprite.modulate = Color(0.68, 0.88, 0.68, 1.0)
			_:
				sprite.modulate = Color(1.0, 1.0, 1.0, 1.0)
"

