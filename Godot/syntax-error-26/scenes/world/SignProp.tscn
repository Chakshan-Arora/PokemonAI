[sub_resource type="GDScript" id="GDScript_sign"]
script/source = "extends StaticBody3D

@export var sign_title: String = \"Signpost\"
@export_multiline var sign_text: String = \"A wooden signpost stands quietly here.\"

@onready var label_3d: Label3D = $Label3D
@onready var sprite_3d: Sprite3D = $Sprite3D

func _ready() -> void:
	add_to_group(\"interactable\")
	if is_instance_valid(label_3d):
		label_3d.text = sign_title

func get_interaction_text() -> String:
	return \"Read \" + sign_title

func on_interact(_player_node: Node3D) -> void:
	EventBus.show_message.emit(sign_text)
"

