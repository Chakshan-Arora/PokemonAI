[sub_resource type="GDScript" id="GDScript_treeprop"]
script/source = "extends StaticBody3D

@export_enum(\"oak\", \"pine\") var tree_type: String = \"oak\"
@onready var sprite: Sprite3D = $Sprite3D

func _ready() -> void:
	if is_instance_valid(sprite):
		if tree_type == \"pine\":
			var tex = load(\"res://assets/sprites/world/tree_pine.png\")
			if tex:
				sprite.texture = tex
				sprite.pixel_size = 0.055
				sprite.position.y = 1.75
		else:
			var tex = load(\"res://assets/sprites/world/tree_oak.png\")
			if tex:
				sprite.texture = tex
				sprite.pixel_size = 0.055
				sprite.position.y = 1.75
"

